---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(0 0 0);
    --aw-color-secondary: rgb(30 30 30);
    --aw-color-accent: rgb(60 60 60);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(30 30 30);
    --aw-color-text-muted: rgb(30 30 30 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(0 0 0);

    ::selection {
      background-color: rgb(229 231 235);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(255 255 255);
    --aw-color-secondary: rgb(220 220 220);
    --aw-color-accent: rgb(180 180 180);

    --aw-color-text-heading: rgb(255 255 255);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(0 0 0);

    ::selection {
      background-color: rgb(55 65 81);
      color: white;
    }
  }
</style>
