---
import logoDark from '~/assets/images/logo-dark.png';
import logoWhite from '~/assets/images/logo-white.png';
---

<span class="self-center ml-2 rtl:ml-0 rtl:mr-2 whitespace-nowrap">
  <img src={logoDark.src} alt="Signals | Kernels" class="h-8 md:h-10 block dark:hidden" width="auto" height="40" />
  <img src={logoWhite.src} alt="Signals | Kernels" class="h-8 md:h-10 hidden dark:block" width="auto" height="40" />
</span>
