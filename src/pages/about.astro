---
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import aboutHero from '~/assets/images/about-hero.png';
import aboutEssence from '~/assets/images/about-essence-alt.png';
import aboutMission from '~/assets/images/about-mission.png';

const metadata = {
  title: 'About Us',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About Us"
    image={{
      src: aboutHero,
      alt: 'Abstract data visualization turning chaos into structure',
      class: 'mx-auto rounded-md w-full melting-hero-image',
    }}
  >
    <Fragment slot="title">
      Turning Chaos <br class="hidden xl:inline" />
      <span class="text-accent dark:text-white">into Insight</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold">We don't rent you software. We build you an asset.</span> Signals | Kernels is a premier AI engineering firm that builds custom, sovereign solutions that you own. We combine deep US technical expertise with native Middle Eastern roots to deliver intelligence that is secure, compliant, and culturally fluent — transforming raw data into coherent, actionable insight.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Who We Are"
    stats={[
      { title: 'Founded', amount: '2023' },
      { title: 'Headquarters', amount: 'Chicago' },
      { title: 'Focus Areas', amount: '4' },
      { title: 'AI Modalities', amount: '5+' },
    ]}
  />

  <!-- Content Widget: Our Essence **************** -->

  <Content
    isReversed
    tagline="Our Essence"
    title="Why 'Signals' and 'Kernels'?"
    items={[
      {
        title: 'Signals',
        description:
          'The raw information flowing nonstop from countless sources — data streams, text, images, video, audio, and sensor data. Our world is awash in signals that hold the key to insights, innovations, and improved decision-making.',
      },
      {
        title: 'Kernels',
        description:
          'In machine learning, kernels transform complex data into spaces where hidden patterns emerge. Similarly, an OS kernel orchestrates all processes. Our solutions serve as the essential kernel of intelligence — enabling efficient learning, growth, and adaptability.',
      },
    ]}
    image={{
      src: aboutEssence,
      alt: 'Neural network abstract visualization',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        The Heart of Your Intelligence
      </h3>
      We start from the chaotic signals of the world and channel them into a structured intelligence core, much like a kernel
      that powers every function of an operating system.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget: Mission **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Guiding Through Complexity',
        description:
          'We uncover hidden patterns, anticipate needs, and deliver secure, scalable solutions that enable clients to stay one step ahead — confident, informed, and ready for the future.',
      },
      {
        title: 'Empowerment, Not Dependency',
        description:
          'We don\'t believe in indefinite SaaS lock-in. Through our Civil Servant AI Academy and training programs, we build internal capacity so your teams manage and evolve the systems we build. We build assets you own.',
      },
      {
        title: 'Arabic-Native, Globally Engineered',
        description:
          'Headquartered in Chicago with native Middle Eastern roots, our solutions don\'t just translate — they understand. Arabic-native AI that handles cultural and linguistic nuance, backed by US engineering standards.',
      },
    ]}
    image={{
      src: aboutMission,
      alt: 'Global team collaboration map',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Our Mission</h3>
      To guide organizations through the complexity of modern data landscapes.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps2 Widget: Values ****************** -->

  <Steps2
    title="Our Values"
    subtitle="The principles that drive every solution we build and every partnership we forge."
    items={[
      {
        title: 'Clarity',
        description:
          'Illuminating hidden patterns in messy data so you can see clearly and act decisively.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Integrity',
        description:
          'Ensuring trust, security, and robustness in our solutions — your data deserves the highest standards.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Sovereignty',
        description:
          'Your data, your infrastructure, your asset. We build solutions you own, deployed on your terms — never locked into subscriptions.',
        icon: 'tabler:lock',
      },
      {
        title: 'Ingenuity',
        description:
          'Combining cutting-edge research with creative problem-solving for smarter, faster outcomes.',
        icon: 'tabler:sparkles',
      },
    ]}
  />

  <Steps2
    isReversed={true}
    items={[
      {
        title: 'Resilience',
        description:
          'Building scalable, adaptable systems that evolve with your needs and stand the test of time.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Affordability',
        description:
          'Offering cost-effective intelligence solutions without compromising quality or innovation.',
        icon: 'tabler:coin',
      },
      {
        title: 'Scalability & Empowerment',
        description:
          'Designing solutions that grow with you, empowering confident decision-making at every stage.',
        icon: 'tabler:trending-up',
      },
    ]}
  />

  <!-- Features2 Widget: Location ************** -->

  <Features2
    title="Our Location"
    tagline="Find Us"
    columns={1}
    items={[
      {
        title: 'Chicago, IL, USA',
        description: 'Headquartered in the heart of the Midwest, serving clients worldwide.',
        icon: 'tabler:map-pin',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get in Touch',
        href: '/contact',
        icon: 'tabler:mail',
      },
    ]}
    title="Let's Build Something Together"
    subtitle="Whether you're a small business looking to pilot your first AI solution or a large enterprise seeking custom intelligence systems, we're here to help."
  />
</Layout>

<style>
  :global(.melting-hero-image) {
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);
  }
</style>
