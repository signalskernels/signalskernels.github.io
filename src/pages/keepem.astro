---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = {
  title: 'KEEPEM for Business — Service-as-Software for Document Operations',
};
---

<Layout metadata={metadata}>
  <!-- =====================================================================
       HERO — split visual: phone (capture) + dashboard (decide).
       Drop-in points for real assets:
         · public/keepem-phone-demo.gif      → replaces .phone-screen-placeholder
         · public/keepem-dashboard.png|gif   → replaces .dashboard-screen-placeholder
       Capture today with `flutter test integration_test/screenshots_test.dart`
       (integration_test) or `fastlane screengrab`.
       ===================================================================== -->

  <Hero
    tagline="KEEPEM · Service-as-Software for Document Operations"
    title="Don't buy software. <span class='text-accent'>Hire the agent.</span>"
    subtitle="For 25 years B2B software meant tools that helped a person work faster. KEEPEM is something different. It's an autonomous agent that reads, classifies, reconciles, summarizes, and reports — running on the phones in your team's pockets and the dashboards on your CFO's screen. Capture lives on the edge. The agent runs locally. The work gets done. You're not licensing a product — you're hiring the AP clerk, the analyst, and the auditor as one always-on system."
    actions={[
      { variant: 'primary', text: 'Book a Demo', href: '/contact', icon: 'tabler:mail' },
      { text: 'See How It Works', href: '#paradigm' },
    ]}
  >
    <Fragment slot="image">
      <div class="hero-split-wrapper">
        <!-- Phone capture surface --------------------------------------- -->
        <div class="phone-mock">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <!-- DROP-IN: replace this placeholder with
                 <img src="/keepem-phone-demo.gif" alt="KEEPEM scan flow" /> -->
            <div class="phone-screen-placeholder">
              <div class="placeholder-pulse"></div>
              <p class="placeholder-line-1">Phone capture demo</p>
              <p class="placeholder-line-2"><code>public/keepem-phone-demo.gif</code></p>
            </div>
          </div>
        </div>

        <!-- Connection line — capture → cloud --------------------------- -->
        <div class="hero-bridge" aria-hidden="true">
          <span class="hero-bridge-pulse"></span>
        </div>

        <!-- Dashboard decision surface ---------------------------------- -->
        <div class="dashboard-mock">
          <div class="dashboard-chrome">
            <span class="dashboard-dot dashboard-dot-r"></span>
            <span class="dashboard-dot dashboard-dot-y"></span>
            <span class="dashboard-dot dashboard-dot-g"></span>
            <span class="dashboard-url">app.keepem.io / dashboard</span>
          </div>
          <div class="dashboard-screen">
            <!-- DROP-IN: replace this placeholder with
                 <img src="/keepem-dashboard.png" alt="KEEPEM dashboard" /> -->
            <div class="dashboard-screen-placeholder">
              <div class="dash-grid">
                <div class="dash-card dash-card-tall">
                  <span class="dash-eyebrow">Spend · this month</span>
                  <span class="dash-figure">$184,720</span>
                  <span class="dash-trend">▲ 12% vs Apr</span>
                  <div class="dash-spark"></div>
                </div>
                <div class="dash-card">
                  <span class="dash-eyebrow">Captures today</span>
                  <span class="dash-figure-sm">2,431</span>
                </div>
                <div class="dash-card">
                  <span class="dash-eyebrow">Anomalies</span>
                  <span class="dash-figure-sm dash-alert">7</span>
                </div>
                <div class="dash-card dash-card-wide">
                  <span class="dash-eyebrow">By location</span>
                  <div class="dash-bars">
                    <span style="--h: 80%"></span>
                    <span style="--h: 55%"></span>
                    <span style="--h: 92%"></span>
                    <span style="--h: 41%"></span>
                    <span style="--h: 70%"></span>
                    <span style="--h: 33%"></span>
                  </div>
                </div>
              </div>
              <p class="placeholder-line-2 dash-caption">Replace with <code>public/keepem-dashboard.png</code></p>
            </div>
          </div>
        </div>
      </div>
    </Fragment>
  </Hero>

  <!-- Stats — outcome metrics, not implementation ********************** -->

  <Stats
    stats={[
      { amount: '$0', title: 'Marginal AI cost per query', icon: 'tabler:coin-off' },
      { amount: '0 ms', title: 'Cloud round-trip on the agent', icon: 'tabler:bolt' },
      { amount: 'Offline', title: 'Works in the basement, the field, in flight', icon: 'tabler:wifi-off' },
      { amount: 'Sovereign', title: 'Data physically cannot leak through the LLM', icon: 'tabler:shield-lock' },
    ]}
  />

  <!-- Paradigm Shift — SaaS → Service-as-Software ********************* -->

  <Content
    id="paradigm"
    tagline="The Paradigm Shift"
    title="From Software-as-a-Service to <span class='text-accent'>Service-as-Software</span>"
    items={[
      {
        title: 'The old contract: software helps people work faster.',
        description:
          'You bought tools. Your team operated them. The price was per-seat, the value was per-hour-saved. Document software meant scanners, OCR engines, and forms — and an army of clerks to feed them.',
      },
      {
        title: 'The new contract: software does the work.',
        description:
          'KEEPEM closes the loop. The agent reads the receipt, classifies it, reconciles it against the PO, flags the anomaly, summarizes the day, posts to the ledger, alerts the controller. The clerk is no longer in the loop for the routine 80% — only the exceptions surface for human judgement.',
      },
      {
        title: 'The economics shift.',
        description:
          'Stop paying per seat for a tool that needs an operator. Start paying for outcomes the agent delivers — reconciled books, real-time spend, audit-ready trails, anomalies caught before payment. The seat-based pricing of the SaaS era is on borrowed time. Outcome-based pricing is what a digital workforce looks like.',
      },
      {
        title: 'The value shift.',
        description:
          "KEEPEM closes hundreds of open tickets in your AP queue overnight, not next month after a new hire ramps. It scales linearly with documents, not headcount. And it doesn't go on PTO, doesn't fat-finger a vendor name, doesn't lose a receipt at month-end.",
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Software That Sells Work, Not Seats
      </h3>
      The thesis everyone in venture is talking about — Foundation Capital's "Service-as-Software," Sarah Tavel's "sell the work, not the software" — KEEPEM is what it looks like in production for document-heavy operations. Not a chat wrapper. Not a copilot. An autonomous agent that owns the workflow.
    </Fragment>

    <Fragment slot="image">
      <div class="paradigm-comparison">
        <div class="paradigm-card paradigm-old">
          <span class="paradigm-eyebrow">SaaS · 2000–2025</span>
          <h4>Software-as-a-Service</h4>
          <ul>
            <li>You buy <strong>tools</strong>.</li>
            <li>Humans <strong>operate</strong> them.</li>
            <li>Price per <strong>seat</strong>.</li>
            <li>Value per <strong>hour saved</strong>.</li>
            <li>Output: <strong>faster clerks</strong>.</li>
          </ul>
        </div>
        <div class="paradigm-arrow" aria-hidden="true">→</div>
        <div class="paradigm-card paradigm-new">
          <span class="paradigm-eyebrow">SaS · 2026 →</span>
          <h4>Service-as-Software</h4>
          <ul>
            <li>You buy <strong>work</strong>.</li>
            <li>Agents <strong>execute</strong> it.</li>
            <li>Price per <strong>outcome</strong>.</li>
            <li>Value per <strong>workflow closed</strong>.</li>
            <li>Output: <strong>finished tickets</strong>.</li>
          </ul>
        </div>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Skills — workflows the agent performs autonomously ************** -->

  <Features
    id="skills"
    tagline="The Agent's Job Description"
    title="What KEEPEM Does — On Its Own"
    subtitle="Not a chatbot. Not a search box. An autonomous agent that plans, queries, reasons across documents, and acts. Each capability below is a workflow your team used to run by hand. Now the agent owns it — and finishes it before your morning coffee."
    columns={3}
    items={[
      {
        title: 'Vendor reconciliation, autonomously',
        description:
          'The agent matches every invoice against POs, delivery slips, and POS receipts. Discrepancies are routed to AP with the supporting documents already attached. The 80% that match perfectly never need a human eye.',
        icon: 'tabler:scale',
      },
      {
        title: 'Spend, on demand',
        description:
          '"How did this Tuesday compare to last Tuesday across the south region?" The agent decomposes the question, queries the corpus, computes the answer, and cites the underlying scans. The CFO\'s Slack thread is now a one-line query.',
        icon: 'tabler:chart-pie',
      },
      {
        title: 'Anomaly hunting, around the clock',
        description:
          'Duplicate invoice numbers. Price spikes versus the prior delivery. Vendor account changes. Rounded totals that don\'t sum. The agent surfaces every anomaly the moment a document is captured — before the cheque clears.',
        icon: 'tabler:alert-triangle',
      },
      {
        title: 'Compliance lookups',
        description:
          '"Find every contract expiring in the next 90 days." "Pull every HR form from Q4." "Show me anything with a PII flag." The agent knows the corpus, knows the policy, and assembles the answer with audit-grade citations.',
        icon: 'tabler:file-search',
      },
      {
        title: 'Period-over-period close',
        description:
          'The agent prepares your monthly close pack: trial-balance prep, top-vendor moves, anomaly flags, supporting scans. What used to take a week of tickets is now a single review meeting on Monday morning.',
        icon: 'tabler:report-analytics',
      },
      {
        title: 'Custom workflows you author once',
        description:
          'Write a skill: "every Friday at 5pm, summarize the week\'s spend by manager and email the CFO. Flag any line over $5k. Route to approval." The agent runs it forever — or until you change it. No clerk required.',
        icon: 'tabler:code',
      },
      {
        title: 'Receipt-to-ledger, end to end',
        description:
          'Cashier scans. Agent extracts. Agent maps to GL account, cost center, tax code, project. Agent posts to QuickBooks / NetSuite / SAP. Agent files the scan in your archive. The whole journey, no human touch — except review.',
        icon: 'tabler:transfer-in',
      },
      {
        title: 'Plain-English search across everything',
        description:
          '"Coffee receipts from Atlanta-3 last quarter under $50 paid on the fleet card." Plain English, every document instantly retrievable, with the original scan one tap away. No tagging. No filing. The agent already filed it.',
        icon: 'tabler:search',
      },
      {
        title: 'Voice-first capture for the field',
        description:
          '"Spent forty-five at the gas station, fleet card, route 12." The agent extracts the amount, vendor type, payment method, and job assignment — and the expense is in the system before the truck pulls out of the lot.',
        icon: 'tabler:microphone',
      },
    ]}
  />

  <!-- Duality — on-device + cloud as one platform ********************* -->

  <Content
    id="duality"
    isReversed
    tagline="Two Surfaces · One Platform"
    title="On-Device Where It Matters. Cloud Where It Pays."
    items={[
      {
        title: 'Capture lives on the phone.',
        description:
          'Cashiers, drivers, technicians, and managers capture documents in seconds — even with no signal, even in the back of a warehouse. Camera, voice, photo library, or a connected POS printer feed: it all flows into the same vault on the device.',
      },
      {
        title: 'Decisions live in the cloud.',
        description:
          'When the device gets a connection, structured data syncs to your dashboard: spend by vendor, by location, by category, by manager. Anomaly alerts. Approval workflows. Drill-down to the original scan in one click. Your finance team finally sees the field in real time.',
      },
      {
        title: 'You choose the boundary.',
        description:
          'Sensitive documents stay on the phone and never round-trip to the cloud. Operational documents sync the moment the network is up. The split is policy-driven — set it once, audit it anytime.',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Local Where Privacy Matters. Connected Where Scale Pays.
      </h3>
      Most document AI products force a choice: cloud-only (fast scale, weak privacy) or device-only (private but isolated). KEEPEM was built so you don't have to choose.
    </Fragment>

    <Fragment slot="image">
      <!-- DROP-IN: a side-by-side flow diagram or animated render of the
           hybrid architecture. For a quick win, capture an integration_test
           that runs a scan + opens the dashboard, screenshot both. -->
      <div class="duality-illustration">
        <div class="duality-side duality-device">
          <span class="duality-icon">📱</span>
          <h4>On-Device</h4>
          <ul>
            <li>Offline-first capture</li>
            <li>Private by default</li>
            <li>Zero per-scan cost</li>
            <li>Biometric vault</li>
          </ul>
        </div>
        <div class="duality-link" aria-hidden="true">
          <span class="duality-link-pulse"></span>
        </div>
        <div class="duality-side duality-cloud">
          <span class="duality-icon">☁️</span>
          <h4>In the Cloud</h4>
          <ul>
            <li>Team dashboards</li>
            <li>POS / ERP integrations</li>
            <li>Approvals &amp; alerts</li>
            <li>Audit trail &amp; export</li>
          </ul>
        </div>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- On-Device Wins — economics, sovereignty, latency, lock-in ******* -->

  <Features2
    id="on-device"
    tagline="Why On-Device Wins"
    title="On-Device Isn't a Privacy Checkbox. It's a New Economics."
    subtitle="Most agentic platforms run on cloud frontier models. That means a per-query meter clicking every time the agent thinks. At your scale, that meter becomes your second-largest cost line. KEEPEM runs the agent on the phones in your team's pockets — and the math changes everything."
    columns={2}
    items={[
      {
        title: 'Zero marginal AI cost',
        description:
          'Every scan, every question, every workflow run — flat license, no per-token meter. Whether the agent answers ten questions a day or ten thousand, your bill doesn\'t move. At 10,000 receipts a day across 50 stores, that\'s the difference between a six-figure annual API bill and zero.',
        icon: 'tabler:coin-off',
      },
      {
        title: 'No round-trip latency',
        description:
          'No network call. No cold-start on someone else\'s server. The agent answers as fast as the phone can think — typically under a second. Your CFO asks the question and the chart appears before they finish their sentence.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Connectivity-independent by design',
        description:
          'Capture, structure, search, ask — all of it runs end-to-end with no signal. Cellular dead zones, basement stockrooms, in-flight, on a barge, in a cellular-blocked secure facility. The agent works there. Most cloud-only platforms simply don\'t.',
        icon: 'tabler:wifi-off',
      },
      {
        title: 'Sovereignty by physics, not policy',
        description:
          'Your scans don\'t leak through the LLM because the LLM lives on the device. There is no checkbox, no DPA addendum, no "trust us with your prompts." The data doesn\'t leave the perimeter because there\'s nowhere for it to go. Healthcare, finance, defense, legal — postures that fail cloud-LLM review pass on-device by default.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'No model vendor lock-in',
        description:
          'KEEPEM runs on open-weight models. If a frontier vendor flipped a pricing switch tomorrow, doubled token costs, deprecated the model you depend on, or got blocked in your jurisdiction, KEEPEM keeps running unchanged. You don\'t inherit anyone else\'s commercial risk.',
        icon: 'tabler:lock-open',
      },
      {
        title: 'Frontier-quality, in your pocket',
        description:
          "On-device models in 2026 hit parity with last year's cloud frontier on the document-understanding tasks that matter for this business. The is-on-device-good-enough question is settled. The new question is — why are you still paying cloud rates for a workflow the phone can already run?",
        icon: 'tabler:device-mobile',
      },
      {
        title: 'Predictable, capped TCO',
        description:
          'A token-metered cloud agent has unbounded cost — usage spikes become invoice spikes. KEEPEM\'s cost ceiling is the device fleet you already operate. Procurement signs once; the agent runs forever.',
        icon: 'tabler:chart-arrows',
      },
      {
        title: 'Your competitors can\'t catch up by writing a check',
        description:
          'Anyone can wire up GPT or Gemini Pro behind a chat box. Building a true on-device agentic loop — capture, classify, plan, act, observe, synthesize — entirely in 4 GB of phone RAM is a multi-year engineering moat. KEEPEM is on the other side of that moat.',
        icon: 'tabler:rocket',
      },
    ]}
  />

  <!-- Use Cases — B2B verticals **************************************** -->

  <Content
    tagline="Built For"
    title="Industries Where Paper Is Money"
    items={[
      {
        title: 'Retail & Multi-Location',
        description:
          'Vendor invoices captured at every store and rolled up to HQ overnight. Reconcile against POS automatically — duplicate billings flagged before they\'re paid, price-creep surfaced before it eats margin.',
      },
      {
        title: 'Restaurants & Hospitality',
        description:
          'Supplier deliveries scanned at the back door. Daily food cost rolls into the GM\'s morning briefing. Multi-unit operators see chain-wide trends without weekly spreadsheet work.',
      },
      {
        title: 'Field Services & Construction',
        description:
          'Job-site receipts, equipment bills, permit photos — captured by techs, attached to the right job, ready for invoicing the same day. No more shoebox-of-receipts at month-end.',
      },
      {
        title: 'Logistics & Distribution',
        description:
          'Proof of delivery, BOLs, customs paperwork. Captured at the dock, structured automatically, available to billing and customer service in seconds — not the day-after-tomorrow.',
      },
      {
        title: 'Healthcare & Clinics',
        description:
          'Intake forms, insurance cards, clinical referrals — captured at the desk, structured for the EMR, never sent to a third-party cloud. Sensitive documents stay on the device by policy.',
      },
      {
        title: 'Professional Services',
        description:
          'Client expense reports, vendor invoices, contract scans. Auto-coded to projects and clients. Billable expenses surface for the partner-in-charge before the client meeting, not after.',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Anywhere a Document Becomes Cash
      </h3>
      Wherever your business turns paper into revenue, recovery, or compliance — KEEPEM closes the gap between the moment of truth and the system of record.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Integrations Showcase ******************************************* -->

  <Features2
    title="Plugs Into the Stack You Already Run"
    subtitle="A document platform is only as useful as the systems it feeds. KEEPEM ships with native connectors for the back-office tools your team is already using — and a clean API for the ones you've built yourself."
    tagline="Integrations"
    columns={2}
    items={[
      {
        title: 'Point of Sale',
        description:
          'Square, Toast, Lightspeed, Clover, Shopify POS. Receipts captured at the register reconcile against vendor invoices automatically — overcharges and duplicate payments surface before money leaves the account.',
        icon: 'tabler:cash-register',
      },
      {
        title: 'Accounting & ERP',
        description:
          'QuickBooks, Xero, NetSuite, SAP, Microsoft Dynamics, Oracle. Structured expenses post directly to the right account, cost center, and tax code — no more manual data entry, no more month-end scramble.',
        icon: 'tabler:calculator',
      },
      {
        title: 'BI & Data Warehouse',
        description:
          'Snowflake, BigQuery, Redshift, Looker, Tableau, Power BI. Document data lands in your warehouse next to your sales and ops data — so the questions finance can\'t answer today become a chart by Monday.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Storage & Document Systems',
        description:
          'Google Drive, OneDrive, iCloud Business, S3, SharePoint, Box. Scans archive into your existing folder structure — searchable, indexed, and tied back to the structured record in KEEPEM.',
        icon: 'tabler:cloud-upload',
      },
      {
        title: 'Webhooks & REST API',
        description:
          'Every event — scan completed, anomaly flagged, approval requested — fires a webhook your systems can act on. The full corpus is queryable through a clean REST API for your own dashboards and pipelines.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Single Sign-On & Identity',
        description:
          'Okta, Azure AD, Google Workspace, OneLogin. SCIM provisioning, role mapping, audit-grade access logs. Onboard a new store, location, or business unit in minutes — not a procurement cycle.',
        icon: 'tabler:key',
      },
    ]}
  />

  <!-- Steps — the lifecycle ******************************************* -->

  <Steps
    title="From the Counter to the Boardroom — in Seconds"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Capture</span>',
        description:
          'A cashier rings up a delivery. The driver hands over a paper invoice. The cashier scans it on the store iPhone — three seconds, no typing. The vault is encrypted, biometric-locked, and works whether or not the store has a connection.',
        icon: 'tabler:capture',
      },
      {
        title: 'Step 2: <span class="font-medium">Understand</span>',
        description:
          'Vendor, line items, totals, tax, payment terms, due date — all extracted on the phone, before anything leaves the building. The cashier sees the structured record immediately and can fix anything that looks off.',
        icon: 'tabler:wand',
      },
      {
        title: 'Step 3: <span class="font-medium">Sync</span>',
        description:
          'When the network is up, structured data flows to your cloud — your KEEPEM tenant or your own. Anomalies are flagged automatically: duplicate invoice numbers, price spikes versus the last delivery, totals that don\'t sum.',
        icon: 'tabler:cloud-share',
      },
      {
        title: 'Step 4: <span class="font-medium">Decide</span>',
        description:
          'The dashboard updates in real time. Finance sees today\'s spend by store before noon. The CFO asks "how does this Tuesday compare to last Tuesday?" and gets an answer with sources — not a Slack thread, not a PDF.',
        icon: 'tabler:chart-dots',
      },
    ]}
  />

  <!-- Dashboard deep dive — second screenshot drop-in ***************** -->

  <Content
    isReversed
    tagline="The Web App"
    title="A Back Office That Actually Sees the Field"
    items={[
      {
        title: 'Live spend boards',
        description:
          'Total, by category, by vendor, by location, by manager. Drill into any number to see the actual scans behind it. Filters that finance writes themselves — no analyst ticket required.',
      },
      {
        title: 'Anomaly alerts',
        description:
          'Duplicate invoice numbers. Price increases over a threshold. Vendors that suddenly bill from a new account. Totals that don\'t sum. Routed to the right manager the moment they\'re detected.',
      },
      {
        title: 'Approval workflows',
        description:
          'Threshold-based routing, multi-step approvals, delegate-when-out-of-office. Approve from email, approve from mobile, approve from the dashboard. Every action audited.',
      },
      {
        title: 'Export anywhere',
        description:
          'CSV, Excel, JSON, parquet. Scheduled drops to S3, GCS, or your data warehouse. One-click reconciliation packs for your accountant or your auditor.',
      },
    ]}
  >
    <Fragment slot="image">
      <!-- DROP-IN: full dashboard screenshot.
           public/keepem-dashboard-full.png — capture from the web app. -->
      <div class="dashboard-deep-mock">
        <div class="dashboard-chrome">
          <span class="dashboard-dot dashboard-dot-r"></span>
          <span class="dashboard-dot dashboard-dot-y"></span>
          <span class="dashboard-dot dashboard-dot-g"></span>
          <span class="dashboard-url">app.keepem.io / spend</span>
        </div>
        <div class="dashboard-deep-screen">
          <div class="dash-deep-header">
            <span>Spend Overview</span>
            <span class="dash-deep-range">Last 30 days</span>
          </div>
          <div class="dash-deep-row">
            <div class="dash-deep-stat">
              <span class="dash-eyebrow">Total</span>
              <span class="dash-figure">$1.84M</span>
            </div>
            <div class="dash-deep-stat">
              <span class="dash-eyebrow">vs Prev</span>
              <span class="dash-figure dash-alert">+9.4%</span>
            </div>
            <div class="dash-deep-stat">
              <span class="dash-eyebrow">Vendors</span>
              <span class="dash-figure">312</span>
            </div>
            <div class="dash-deep-stat">
              <span class="dash-eyebrow">Flagged</span>
              <span class="dash-figure dash-alert">14</span>
            </div>
          </div>
          <div class="dash-deep-chart">
            <div class="dash-deep-line"></div>
            <div class="dash-deep-line dash-deep-line-2"></div>
          </div>
          <div class="dash-deep-table">
            <div class="dash-deep-trow"><span>Sysco · Atlanta-3</span><span class="dash-alert">$48,210</span></div>
            <div class="dash-deep-trow"><span>US Foods · Dallas-1</span><span>$36,720</span></div>
            <div class="dash-deep-trow"><span>Performance · Phoenix-2</span><span>$22,455</span></div>
            <div class="dash-deep-trow dash-deep-trow-muted"><span>+ 309 more</span><span>—</span></div>
          </div>
